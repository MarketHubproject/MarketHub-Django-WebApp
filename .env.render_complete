# MarketHub Complete Environment Variables for Render Deployment
# Copy this entire content and paste into Render's "Add from .env" feature
# Update the placeholder values with your actual configuration

# =============================================================================
# CORE DJANGO SETTINGS
# =============================================================================
SECRET_KEY=your-super-secret-django-key-change-this-to-random-50-characters
DEBUG=False
DJANGO_SETTINGS_MODULE=markethub.settings_production

# =============================================================================
# DOMAIN AND SECURITY SETTINGS
# =============================================================================
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1,your-custom-domain.com
SITE_URL=https://your-app-name.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com,https://your-custom-domain.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Note: DATABASE_URL will be automatically provided by Render's PostgreSQL service
# DATABASE_URL=postgresql://user:password@host:port/database (auto-generated by Render)

# =============================================================================
# STATIC FILES CONFIGURATION
# =============================================================================
STATIC_URL=/static/
STATIC_ROOT=./staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=./media

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@your-app-name.onrender.com

# For production email (uncomment and configure):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-specific-password
# DEFAULT_FROM_EMAIL=noreply@your-domain.com

# =============================================================================
# PAYMENT PROCESSING (STRIPE)
# =============================================================================
PAYMENT_ENV=test
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# For live payments (uncomment when ready for production):
# PAYMENT_ENV=live
# STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here
# STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret_here

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
WEB_CONCURRENCY=4
PYTHON_VERSION=3.12.7

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_BASE_URL=https://your-app-name.onrender.com/api/
API_THROTTLE_ANON=100/hour
API_THROTTLE_USER=1000/hour

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================
DJANGO_LOG_LEVEL=INFO
ENVIRONMENT=production

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Redis URL will be provided if you add Redis service on Render
# REDIS_URL=redis://red-xxxxx:6379 (auto-generated by Render if using Redis)

# =============================================================================
# ERROR TRACKING (OPTIONAL)
# =============================================================================
# Uncomment if you want to use Sentry for error tracking:
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# ADDITIONAL SECURITY SETTINGS
# =============================================================================
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# =============================================================================
# INSTRUCTIONS FOR CUSTOMIZATION:
# =============================================================================
# 1. Replace "your-app-name" with your actual Render app name
# 2. Replace "your-custom-domain.com" with your actual domain (if any)
# 3. Generate a strong SECRET_KEY (50+ random characters)
# 4. Add your real Stripe keys when ready
# 5. Configure email settings for production use
# 6. Add Sentry DSN if using error tracking
# =============================================================================